# Copiar a .env y reemplazar TODOS los valores. El archivo .env no se sube al repo.

# PostgreSQL
POSTGRES_USER=nodus
POSTGRES_PASSWORD=cambiar-esta-password
POSTGRES_DB=nodus_db

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambiar-esta-password

# JWT: clave larga y aleatoria (mínimo 32 caracteres)
JWT_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_ISSUER=NODUS.API
JWT_AUDIENCE=NODUS.Frontend
JWT_EXPIRE_MINUTES=480

# Puerto del frontend en el host
WEB_PORT=80

# Dirección con la que otros dispositivos (celulares) acceden al sistema, sin barra final.
# Se usa en la URL de los QR de los equipos. Si queda vacía se usa la dirección desde la que
# se abre la app, y un QR generado desde localhost no funciona en el celular.
# Después de cambiarla: docker compose up -d --build web
VITE_PUBLIC_BASE_URL=http://192.168.0.100
